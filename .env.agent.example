# MedEvidence 配置示例
# 复制为项目根目录的 .env.agent 后填写；不要提交真实 Key。
# 已存在的环境变量优先于本文件。

# ---- 模型（阿里云百炼，OpenAI 兼容接口）----
DASHSCOPE_API_KEY=your_key_here
MEDEVIDENCE_MODEL=qwen-plus
MEDEVIDENCE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDEVIDENCE_TIMEOUT_SEC=90

# ---- 检索：qdrant（本地索引）或 hook（自定义函数）----
MEDEVIDENCE_RETRIEVER=qdrant

# 指向包含 meta.json 的 Qdrant local 目录（不是 collection 名，也不是 sqlite 文件）
MEDEVIDENCE_QDRANT_PATH=
MEDEVIDENCE_COLLECTION=bge_m3_v3_2_trial_clean

# 同一索引版本的 SQLite FTS5 文件；留空则只做稠密检索
MEDEVIDENCE_BM25_DB=

# 嵌入模型与设备：cpu 或 cuda:0（需与 PyTorch 版本匹配）
MEDEVIDENCE_EMBED_MODEL=BAAI/bge-m3
MEDEVIDENCE_DEVICE=cpu

# ---- 检索预算与门控 ----
# 单轮返回块数（1-40）
MEDEVIDENCE_TOP_K=8
# 检索硬上限（1-4）
MEDEVIDENCE_MAX_ROUNDS=3
# 登记证据块上限（1-30）
MEDEVIDENCE_MAX_EVIDENCE=12
# answered 所需的启发式覆盖率（0-1）。1.0 很保守，常见结果是 partial。
MEDEVIDENCE_COVERAGE_THRESHOLD=1.0
# 1=对每条主张做语义支持核验；0=只核验引用 ID
MEDEVIDENCE_SEMANTIC_VERIFY=1
# 1=把问题与检索文本写入本地轨迹；默认 0 只记录哈希
MEDEVIDENCE_TRACE_CONTENT=0

# ---- 自定义检索（可选）----
# MEDEVIDENCE_RETRIEVER=hook
# MEDEVIDENCE_RETRIEVER_HOOK=my_retrieval_bridge:retrieve
